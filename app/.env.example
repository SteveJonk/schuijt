# Copy this file to `.env` and fill in your Sanity project id.
# Find it at https://www.sanity.io/manage (or run `npx sanity projects list`).

# Public — ships in the browser bundle, not a secret.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-26

# The site's public origin, no trailing slash. Defaults to http://localhost:3000.
# Set it in production: it is what makes OG image URLs, the sitemap and
# robots.txt absolute.
NEXT_PUBLIC_SITE_URL=

# Analytics — both optional. Leave empty and no third-party script is loaded.
# GTM container id, e.g. GTM-XXXXXXX.
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
# Meta (Facebook) pixel id, e.g. 123456789012345.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# --- Forms ---------------------------------------------------------------
# Server-only. The submit route prefers these over Formulierinstellingen in the
# studio, because a dataset is readable by anyone who knows the project id.
# `mailjet` or `smtp`. Overrides "Mail provider" in Formulierinstellingen.
MAIL_PROVIDER=
# Mailjet credentials: https://app.mailjet.com/account/apikeys
MAILJET_API_KEY=
MAILJET_API_SECRET=
# Own SMTP server. SMTP_SECURITY is `starttls` (587), `ssl` (465) or `none`
# (25); SMTP_PORT only when the server uses a non-standard port.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
# Sender address. Must be a sender the provider accepts (for SMTP usually the
# login address itself). Falls back to the admin address in
# Formulierinstellingen. MAILJET_FROM_EMAIL still works as an older name.
MAIL_FROM_EMAIL=
# Guards /api/test-mail (the "Send test mail" button in Formulierinstellingen).
# Any long random string; the editor pastes it into the studio once.
MAIL_TEST_SECRET=
# Default recipient. Overrides the admin address in Formulierinstellingen; a
# form with its own recipients overrides both.
CONTACT_ADMIN_EMAIL=
# Only needed when reCAPTCHA is switched on in Formulierinstellingen. The site
# key is public and lives there; this one is not.
RECAPTCHA_SECRET_KEY=

# Server-only. Needed by `npm run seed` to write documents, and at runtime by
# the Google reviews sync (/api/google-reviews) — so set it on Netlify too.
# Create one at https://www.sanity.io/manage -> API -> Tokens, with Editor rights.
SANITY_API_WRITE_TOKEN=

# --- Sentry (optional) ---------------------------------------------------
# Leave the DSN empty and no Sentry code is loaded anywhere: not in the
# browser bundle, not on the server, and the build plugin is skipped.
# Find the DSN under Project settings -> Client Keys (DSN). Not a secret.
NEXT_PUBLIC_SENTRY_DSN=
# Share of transactions traced, 0-1. Defaults to 1.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Build-time only, for uploading source maps so stack traces are readable.
# Org and project slugs from the Sentry URL; the token from
# https://sentry.io/settings/account/api/auth-tokens/ with project:releases.
# Without the token the build still works, it just skips the upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Unlocks the test page at /sentry-test?secret=<this> (and the API route it
# calls). Leave empty and both answer 404. Server-only; a long random string.
SENTRY_TEST_SECRET=

# --- Cache revalidation ---------------------------------------------------
# Shared secret for the Sanity webhook that calls /api/revalidate after a
# publish. Pick a long random string and enter the same one in the webhook
# (sanity.io/manage -> API -> Webhooks). Server-only.
SANITY_REVALIDATE_SECRET=

# --- Google reviews sync ---------------------------------------------------
# Server-only. Google Cloud API key with "Places API (New)" enabled
# (console.cloud.google.com -> APIs & Services). Restrict it to that API.
GOOGLE_PLACES_API_KEY=
# Shared secret for POST /api/google-reviews (header x-sync-secret). Used by the
# hourly Netlify function and pasted once into the studio's Google-koppeling
# page. Pick a long random string, e.g. `openssl rand -hex 32`.
GOOGLE_REVIEWS_SYNC_SECRET=
# Local only, for the one-off `npm run reviews:backfill` (all reviews, not just 5).
SERPAPI_API_KEY=
